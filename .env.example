# ───────────── AI Expense Agent ─────────────
# Copy to `.env` and fill in. Never commit the real .env.

# ── LLM provider ──
# "openai" (default) or "groq" (OpenAI-compatible endpoint, free tier available)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY= 
GROQ_MODEL=openai/gpt-oss-20b

# ── Security ──
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──
# Local dev (default): SQLite file in backend/
DATABASE_URL=sqlite:///./expense_agent.db
# Docker Compose overrides this to PostgreSQL automatically. For your own Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/expense_agent

# ── Misc ──
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker Compose Postgres credentials (only used by docker-compose.yml)
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_agent
